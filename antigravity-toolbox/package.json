{
	"name": "antigravity-toolbox",
	"displayName": "Antigravity 控制中心 (Toolbox)",
	"description": "VS Code 相容 IDE 側邊欄控制中心（Cursor / VS Code / VS Code Insiders / Antigravity）：整合多專案工作區同名修正、專案腳本執行器 (ps1/bat/cmd)、全域設定/技能/規範目錄直達、GitHub Copilot 與 Cline 對話紀錄統計與清理、Brain 對話歷史紀錄清理與 settings.json 快速編輯",
	"version": "1.6.0",
	"publisher": "antigravity-toolkit",
	"engines": {
		"vscode": "^1.80.0"
	},
	"categories": [
		"Other"
	],
	"main": "./extension.js",
	"activationEvents": [
		"onStartupFinished"
	],
	"contributes": {
		"configuration": {
			"title": "Antigravity",
			"properties": {
				"antigravity.locale": {
					"type": "string",
					"default": "zh-TW",
					"enum": [
						"zh-TW",
						"zh-CN",
						"en"
					],
					"enumDescriptions": [
						"繁體中文 (Traditional Chinese)",
						"简体中文 (Simplified Chinese)",
						"English"
					],
					"description": "Antigravity 外掛全域介面語言 (Global Interface Language for Antigravity Plugins)"
				},
				"antigravity.uiFlavor": {
					"type": "string",
					"default": "auto",
					"enum": [
						"auto",
						"antigravity",
						"cursor",
						"copilot",
						"cline"
					],
					"enumDescriptions": [
						"自動：依目前開啟的 IDE 判定 (Auto-detect)；面板上點「目前宿主」的類別即回到此值（面板已無獨立的自動鈕）",
						"Antigravity：顯示 ~/.gemini 與 Brain 對話記憶庫",
						"Cursor：顯示 ~/.cursor 與 agent-transcripts 對話紀錄",
						"Copilot：顯示 VS Code Copilot 的 prompts 與 chatSessions",
						"Cline：顯示 ~/.cline 的規則/技能/外掛與 data/sessions 對話紀錄（Cline 是外掛，只能手動選擇）"
					],
					"description": "控制中心要顯示哪一套 IDE／工具的專屬功能與資料路徑，對應面板頂部的「類別切換鈕」。auto 會依目前宿主 IDE 自動判定；手動指定後即使切換到其他 IDE 也會固定顯示所選類別。面板切換鈕為彩色 chips（各類別一色）"
				},
				"antigravity.showAntigravityModulesInVsCode": {
					"type": "boolean",
					"default": false,
					"description": "在純 VS Code 等相容環境中若偵測到本機有 Antigravity，是否顯示 Antigravity 專屬卡片（全域自訂 ~/.gemini 與對話記憶庫 Brain）。預設為關閉 (false)；Cursor 環境自帶專屬配置不受此限制。注意：此設定優先於 Copilot 卡片，若本機同時具備 Antigravity 與 Copilot，開啟本設定將改顯示 Antigravity 路徑"
				},
				"antigravity.showCopilotModulesInVsCode": {
					"type": "boolean",
					"default": true,
					"description": "在 VS Code 偵測到 GitHub Copilot 時，是否顯示對應的全域自訂卡片（User 設定目錄、mcp.json、Skills、prompts、Plugins）與對話記憶庫卡片（Copilot Chat 對話紀錄統計與清理）。預設為開啟 (true)；設為 false 可隱藏這兩張卡片"
				},
				"antigravity.syncSkillsOnFolderToggle": {
					"type": "boolean",
					"default": false,
					"description": "開啟後立即依啟用專案對齊 ~/.agents/skills，並跟隨專案開關與 Skills 目錄變更；關閉則停止跟隨並解除所有指向全域資料夾的連結（僅移除連結，實體資料夾保留；適用 Codex / Cline）"
				},
				"antigravity.skillSyncExcludeFirstProject": {
					"type": "boolean",
					"default": false,
					"description": "開啟後，面板專案清單排序第 1 個專案（首專案）不納入 ~/.agents/skills 同步來源，且其先前建立的 Junction 連結會一併解除；關閉則首專案照常同步。僅在「開關專案時同步全域 Skills」開啟時生效"
				}
			}
		},
		"viewsContainers": {
			"activitybar": [
				{
					"id": "antigravity-toolbox-container",
					"title": "Antigravity 控制中心",
					"icon": "media/icons/toolbox-icon.svg"
				}
			]
		},
		"views": {
			"antigravity-toolbox-container": [
				{
					"type": "webview",
					"id": "antigravity.toolboxView",
					"name": "快捷控制台",
					"icon": "media/icons/toolbox-icon.svg"
				}
			]
		},
		"commands": [
			{
				"command": "antigravity.toolbox.openInEditor",
				"title": "在編輯器分頁開啟",
				"category": "Antigravity",
				"icon": "$(split-horizontal)"
			},
			{
				"command": "antigravity.toolbox.refresh",
				"title": "重新整理工作區狀態",
				"category": "Antigravity",
				"icon": "$(refresh)"
			},
			{
				"command": "antigravity.toolbox.fixWorkspace",
				"title": "自動修正工作區同名專案名稱",
				"category": "Antigravity",
				"icon": "$(edit)"
			},
			{
				"command": "antigravity.toolbox.resetWorkspace",
				"title": "重設工作區專案為預設名稱",
				"category": "Antigravity",
				"icon": "$(discard)"
			},
			{
				"command": "antigravity.toolbox.openSettings",
				"title": "開啟 settings.json",
				"category": "Antigravity",
				"icon": "$(gear)"
			},
			{
				"command": "antigravity.toolbox.addScriptToRunner",
				"title": "加入至專案腳本執行器",
				"category": "Antigravity"
			},
			{
				"command": "antigravity.toolbox.focusView",
				"title": "聚焦控制中心側邊欄",
				"category": "Antigravity"
			},
			{
				"command": "antigravity.toolbox.openInEditor.en",
				"title": "Open in Editor Tab",
				"category": "Antigravity",
				"icon": "$(split-horizontal)"
			},
			{
				"command": "antigravity.toolbox.fixWorkspace.en",
				"title": "Auto Fix Duplicate Workspace Project Names",
				"category": "Antigravity",
				"icon": "$(edit)"
			},
			{
				"command": "antigravity.toolbox.resetWorkspace.en",
				"title": "Reset Workspace Projects to Default Names",
				"category": "Antigravity",
				"icon": "$(discard)"
			},
			{
				"command": "antigravity.toolbox.addScriptToRunner.en",
				"title": "Add to Project Script Runner",
				"category": "Antigravity"
			}
		],
		"menus": {
			"view/title": [
				{
					"command": "antigravity.toolbox.openInEditor",
					"when": "view == antigravity.toolboxView && config.antigravity.locale != 'en'",
					"group": "navigation@1"
				},
				{
					"command": "antigravity.toolbox.openInEditor.en",
					"when": "view == antigravity.toolboxView && config.antigravity.locale == 'en'",
					"group": "navigation@1"
				}
			],
			"explorer/context": [
				{
					"command": "antigravity.toolbox.fixWorkspace",
					"group": "navigation@1",
					"when": "resourceExtname == .code-workspace && config.antigravity.locale != 'en'"
				},
				{
					"command": "antigravity.toolbox.fixWorkspace.en",
					"group": "navigation@1",
					"when": "resourceExtname == .code-workspace && config.antigravity.locale == 'en'"
				},
				{
					"command": "antigravity.toolbox.resetWorkspace",
					"group": "navigation@2",
					"when": "resourceExtname == .code-workspace && config.antigravity.locale != 'en'"
				},
				{
					"command": "antigravity.toolbox.resetWorkspace.en",
					"group": "navigation@2",
					"when": "resourceExtname == .code-workspace && config.antigravity.locale == 'en'"
				},
				{
					"command": "antigravity.toolbox.addScriptToRunner",
					"group": "z_antigravity@1",
					"when": "(resourceExtname == .ps1 || resourceExtname == .bat || resourceExtname == .cmd) && config.antigravity.locale != 'en'"
				},
				{
					"command": "antigravity.toolbox.addScriptToRunner.en",
					"group": "z_antigravity@1",
					"when": "(resourceExtname == .ps1 || resourceExtname == .bat || resourceExtname == .cmd) && config.antigravity.locale == 'en'"
				}
			]
		}
	}
}