					"group": "z_script_runner@13",
					"when": "(resourceExtname == .bat || resourceExtname == .cmd) && scriptRunner.isEnglish"
				},
				{
					"command": "scriptRunner.runBat.cn",
					"group": "z_script_runner@13",
					"when": "(resourceExtname == .bat || resourceExtname == .cmd) && scriptRunner.isSimplified"
				},
				{
					"command": "scriptRunner.runBatAdmin",
					"group": "z_script_runner@14",
					"when": "(resourceExtname == .bat || resourceExtname == .cmd) && !scriptRunner.isEnglish && !scriptRunner.isSimplified"
				},
				{
					"command": "scriptRunner.runBatAdmin.en",
					"group": "z_script_runner@14",
					"when": "(resourceExtname == .bat || resourceExtname == .cmd) && scriptRunner.isEnglish"
				},
				{
