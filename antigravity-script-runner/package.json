				}
			],
			"explorer/context": [
				{
					"command": "scriptRunner.viewFolderImages",
					"group": "z_script_runner@1",
					"when": "(explorerResourceIsFolder || resourceExtname =~ /\\.(png|jpe?g|webp|gif|svg|bmp|ico|avif|tiff?|jfif)$/i) && !scriptRunner.isEnglish && !scriptRunner.isSimplified"
				},
