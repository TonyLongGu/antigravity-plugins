					"group": "navigation@3",
					"when": "(editorLangId == bat || resourceExtname == .bat || resourceExtname == .cmd) && !scriptRunner.isEnglish && !scriptRunner.isSimplified"
				},
				{
					"command": "scriptRunner.runBat.en",
					"group": "navigation@3",
					"when": "(editorLangId == bat || resourceExtname == .bat || resourceExtname == .cmd) && scriptRunner.isEnglish"
				},
				{
					"command": "scriptRunner.runBat.cn",
