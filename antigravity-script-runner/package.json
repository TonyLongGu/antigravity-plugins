				},
				{
					"command": "scriptRunner.runPy",
					"group": "z_script_runner@10",
					"when": "resourceExtname == .py && !scriptRunner.isEnglish && !scriptRunner.isSimplified"
				},
				{
					"command": "scriptRunner.runPy.en",
					"group": "z_script_runner@10",
					"when": "resourceExtname == .py && scriptRunner.isEnglish"
				},
				{
					"command": "scriptRunner.runPy.cn",
					"group": "z_script_runner@10",
					"when": "resourceExtname == .py && scriptRunner.isSimplified"
				},
				{
					"command": "scriptRunner.runPs1",
					"group": "z_script_runner@11",
					"when": "resourceExtname == .ps1 && !scriptRunner.isEnglish && !scriptRunner.isSimplified"
				},
				{
					"command": "scriptRunner.runPs1.en",
					"group": "z_script_runner@11",
					"when": "resourceExtname == .ps1 && scriptRunner.isEnglish"
				},
				{
					"command": "scriptRunner.runPs1.cn",
					"group": "z_script_runner@11",
					"when": "resourceExtname == .ps1 && scriptRunner.isSimplified"
				},
				{
					"command": "scriptRunner.runPs1Admin",
					"group": "z_script_runner@12",
					"when": "resourceExtname == .ps1 && !scriptRunner.isEnglish && !scriptRunner.isSimplified"
				},
