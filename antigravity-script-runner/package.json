					"command": "scriptRunner.viewFolderAudios.cn",
					"group": "z_script_runner@2",
					"when": "(explorerResourceIsFolder || resourceExtname =~ /\\.(mp3|wav|ogg|flac|aac|m4a|wma|aiff?|opus|weba)$/i) && scriptRunner.isSimplified"
				},
				{
					"command": "scriptRunner.viewFolderVideos",
					"group": "z_script_runner@3",
					"when": "(explorerResourceIsFolder || resourceExtname =~ /\\.(mp4|webm|mkv|mov|avi|wmv|flv|m4v|ts|ogv)$/i) && !scriptRunner.isEnglish && !scriptRunner.isSimplified"
				},
				{
					"command": "scriptRunner.viewFolderVideos.en",
					"group": "z_script_runner@3",
					"when": "(explorerResourceIsFolder || resourceExtname =~ /\\.(mp4|webm|mkv|mov|avi|wmv|flv|m4v|ts|ogv)$/i) && scriptRunner.isEnglish"
				},
