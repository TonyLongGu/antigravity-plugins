				},
				{
					"command": "scriptRunner.viewFolderAudios.en",
					"group": "z_script_runner@2",
					"when": "(explorerResourceIsFolder || resourceExtname =~ /\\.(mp3|wav|ogg|flac|aac|m4a|wma|aiff?|opus|weba)$/i) && scriptRunner.isEnglish"
				},
