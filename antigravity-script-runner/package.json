					"command": "scriptRunner.viewFolderImages.cn",
					"group": "z_script_runner@1",
					"when": "(explorerResourceIsFolder || resourceExtname =~ /\\.(png|jpe?g|webp|gif|svg|bmp|ico|avif|tiff?|jfif)$/i) && scriptRunner.isSimplified"
				},
				{
					"command": "scriptRunner.viewFolderAudios",
					"group": "z_script_runner@2",
