{
	"name": "antigravity-script-runner",
	"displayName": "腳本右鍵執行工具 (Script Runner)",
	"description": "在 Cursor、Antigravity IDE 與 VS Code 檔案總管與編輯器為 .bat、.cmd、.ps1、.py 腳本提供右鍵與右上角 ▶ 按鈕執行功能（在內建 PowerShell 終端機安全執行），並提供圖片、聲音、影片多媒體檢視器",
	"version": "1.7.1",
	"publisher": "antigravity-toolkit",
	"engines": {
		"vscode": "^1.80.0"
	},
	"categories": [
		"Other"
	],
	"main": "./extension.js",
	"scripts": {
		"test": "node tests/run-all.js"
	},
	"activationEvents": [
		"onStartupFinished"
	],
	"contributes": {
		"customEditors": [
			{
				"viewType": "scriptRunner.imageViewer",
				"displayName": "圖片檢視器 (Image Viewer)",
				"selector": [
					{
						"filenamePattern": "*.{png,jpg,jpeg,webp,gif,svg,bmp,ico,avif,tif,tiff,jfif,PNG,JPG,JPEG,WEBP,GIF,SVG,BMP,ICO,AVIF,TIF,TIFF,JFIF}"
					}
				],
				"priority": "default"
			},
			{
				"viewType": "scriptRunner.audioViewer",
				"displayName": "聲音檢視器 (Audio Viewer)",
				"selector": [
					{
						"filenamePattern": "*.{mp3,wav,ogg,flac,aac,m4a,wma,aif,aiff,opus,weba,MP3,WAV,OGG,FLAC,AAC,M4A,WMA,AIF,AIFF,OPUS,WEBA}"
					}
				],
				"priority": "default"
			},
			{
				"viewType": "scriptRunner.videoViewer",
				"displayName": "影片播放器 (Video Viewer)",
				"selector": [
					{
						"filenamePattern": "*.{mp4,webm,mkv,mov,avi,wmv,flv,m4v,ts,ogv,MP4,WEBM,MKV,MOV,AVI,WMV,FLV,M4V,TS,OGV}"
					}
				],
				"priority": "default"
			}
		],
		"configuration": {
			"title": "腳本右鍵執行工具 (Script Runner)",
			"properties": {
				"scriptRunner.runAsAdmin": {
					"type": "boolean",
					"default": true,
					"description": "是否預設以系統管理員身分 (Administrator) 提權執行腳本"
				},
				"scriptRunner.keepWindowOpen": {
					"type": "boolean",
					"default": true,
					"description": "以系統管理員身分執行時，是否在腳本執行完畢後保持視窗開啟以供檢視輸出與報錯"
				},
				"scriptRunner.locale": {
					"type": "string",
					"enum": [
						"zh-TW",
						"zh-CN",
						"en"
					],
					"enumDescriptions": [
						"繁體中文 (Traditional Chinese)",
						"简体中文 (Simplified Chinese)",
						"English"
					],
					"description": "擴充套件介面語系。未設定時自動跟隨 IDE 顯示語言（並相容 antigravity.locale）"
				}
			}
		},
		"commands": [
			{
				"command": "scriptRunner.viewFolderImages",
				"title": "檢視圖片",
				"category": "圖片檢視",
				"icon": "$(file-media)"
			},
			{
				"command": "scriptRunner.viewFolderImages.en",
				"title": "View Images",
				"category": "Image Viewer",
				"icon": "$(file-media)"
			},
			{
				"command": "scriptRunner.viewFolderAudios",
				"title": "檢視聲音",
				"category": "聲音檢視",
				"icon": "$(unmute)"
			},
			{
				"command": "scriptRunner.viewFolderAudios.en",
				"title": "View Audio",
				"category": "Audio Viewer",
				"icon": "$(unmute)"
			},
			{
				"command": "scriptRunner.viewFolderVideos",
				"title": "檢視影片",
				"category": "影片檢視",
				"icon": "$(device-camera-video)"
			},
			{
				"command": "scriptRunner.viewFolderVideos.en",
				"title": "View Videos",
				"category": "Video Viewer",
				"icon": "$(device-camera-video)"
			},
			{
				"command": "scriptRunner.runPy",
				"title": "執行 Python 腳本",
				"category": "腳本執行",
				"icon": "$(play)"
			},
			{
				"command": "scriptRunner.runPs1",
				"title": "執行 PowerShell 腳本",
				"category": "腳本執行",
				"icon": "$(play)"
			},
			{
				"command": "scriptRunner.runPs1Admin",
				"title": "執行 PowerShell 腳本 (系統管理員)",
				"category": "腳本執行",
				"icon": "$(shield)"
			},
			{
				"command": "scriptRunner.runBat",
				"title": "執行批次檔",
				"category": "腳本執行",
				"icon": "$(play)"
			},
			{
				"command": "scriptRunner.runBatAdmin",
				"title": "執行批次檔 (系統管理員)",
				"category": "腳本執行",
				"icon": "$(shield)"
			},
			{
				"command": "scriptRunner.runPy.en",
				"title": "Run Python Script",
				"category": "Script Runner",
				"icon": "$(play)"
			},
			{
				"command": "scriptRunner.runPs1.en",
				"title": "Run PowerShell Script",
				"category": "Script Runner",
				"icon": "$(play)"
			},
			{
				"command": "scriptRunner.runPs1Admin.en",
				"title": "Run PowerShell Script (Admin)",
				"category": "Script Runner",
				"icon": "$(shield)"
			},
			{
				"command": "scriptRunner.runBat.en",
				"title": "Run Batch File",
				"category": "Script Runner",
				"icon": "$(play)"
			},
			{
				"command": "scriptRunner.runBatAdmin.en",
				"title": "Run Batch File (Admin)",
				"category": "Script Runner",
				"icon": "$(shield)"
			},
			{
				"command": "scriptRunner.viewFolderImages.cn",
				"title": "查看图片",
				"category": "图片查看",
				"icon": "$(file-media)"
			},
			{
				"command": "scriptRunner.viewFolderAudios.cn",
				"title": "查看声音",
				"category": "声音查看",
				"icon": "$(unmute)"
			},
			{
				"command": "scriptRunner.viewFolderVideos.cn",
				"title": "查看影片",
				"category": "影片查看",
				"icon": "$(device-camera-video)"
			},
			{
				"command": "scriptRunner.runPy.cn",
				"title": "执行 Python 脚本",
				"category": "脚本执行",
				"icon": "$(play)"
			},
			{
				"command": "scriptRunner.runPs1.cn",
				"title": "执行 PowerShell 脚本",
				"category": "脚本执行",
				"icon": "$(play)"
			},
			{
				"command": "scriptRunner.runPs1Admin.cn",
				"title": "执行 PowerShell 脚本 (系统管理员)",
				"category": "脚本执行",
				"icon": "$(shield)"
			},
			{
				"command": "scriptRunner.runBat.cn",
				"title": "执行批次档",
				"category": "脚本执行",
				"icon": "$(play)"
			},
			{
				"command": "scriptRunner.runBatAdmin.cn",
				"title": "执行批次档 (系统管理员)",
				"category": "脚本执行",
				"icon": "$(shield)"
			}
		],
		"menus": {
			"editor/title": [
				{
					"command": "scriptRunner.runPy",
					"group": "navigation@1",
					"when": "(editorLangId == python || resourceExtname == .py) && !scriptRunner.isEnglish && !scriptRunner.isSimplified"
				},
				{
					"command": "scriptRunner.runPy.en",
					"group": "navigation@1",
					"when": "(editorLangId == python || resourceExtname == .py) && scriptRunner.isEnglish"
				},
				{
					"command": "scriptRunner.runPy.cn",
					"group": "navigation@1",
					"when": "(editorLangId == python || resourceExtname == .py) && scriptRunner.isSimplified"
				},
				{
					"command": "scriptRunner.runPs1",
					"group": "navigation@2",
					"when": "(editorLangId == powershell || resourceExtname == .ps1) && !scriptRunner.isEnglish && !scriptRunner.isSimplified"
				},
				{
					"command": "scriptRunner.runPs1.en",
					"group": "navigation@2",
