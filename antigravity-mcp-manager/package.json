{
	"name": "antigravity-mcp-manager",
	"displayName": "MCP 管理儀表板",
	"description": "Antigravity IDE / Cursor / VS Code 相容的 MCP 儀表板：Antigravity 提供左側面板與原生開關；Cursor 與 VS Code 只顯示底部狀態列",
	"version": "1.9.1",
	"publisher": "antigravity-toolkit",
	"engines": {
		"vscode": "^1.80.0"
	},
	"categories": [
		"Other"
	],
	"main": "./extension.js",
	"activationEvents": [
		"onStartupFinished"
	],
	"contributes": {
		"configuration": {
			"title": "Antigravity",
			"properties": {
				"antigravity.locale": {
					"type": "string",
					"default": "zh-TW",
					"enum": [
						"zh-TW",
						"en"
					],
					"enumDescriptions": [
						"繁體中文 (Traditional Chinese)",
						"English"
					],
					"description": "Antigravity 外掛全域介面語言 (Global Interface Language for Antigravity Plugins)"
				}
			}
		},
		"viewsContainers": {
			"activitybar": [
				{
					"id": "mcp-manager-container",
					"title": "MCP 伺服器管理",
					"icon": "media/icons/mcp-icon.svg",
					"when": "mcpManager.showSidebar"
				}
			]
		},
		"views": {
			"mcp-manager-container": [
				{
					"type": "webview",
					"id": "antigravity.mcpManagerView",
					"name": "MCP 控制台",
					"icon": "media/icons/mcp-icon.svg",
					"when": "mcpManager.showSidebar"
				}
			]
		},
		"commands": [
			{
				"command": "antigravity.mcp.openInEditor",
				"title": "在編輯器分頁開啟",
				"category": "MCP",
				"icon": "$(split-horizontal)"
			},
			{
				"command": "antigravity.mcp.refresh",
				"title": "重新載入 MCP 設定",
				"category": "MCP",
				"icon": "$(refresh)"
			},
			{
				"command": "antigravity.mcp.focusView",
				"title": "聚焦 MCP 側邊欄面板",
				"category": "MCP"
			},
			{
				"command": "antigravity.mcp.openInEditor.en",
				"title": "Open in Editor Tab",
				"category": "MCP",
				"icon": "$(split-horizontal)"
			}
		],
		"menus": {
			"commandPalette": [
				{
					"command": "antigravity.mcp.focusView",
					"when": "mcpManager.showSidebar"
				},
				{
					"command": "antigravity.mcp.openInEditor",
					"when": "mcpManager.showSidebar && !mcpManager.isEnglish"
				},
				{
					"command": "antigravity.mcp.openInEditor.en",
					"when": "mcpManager.showSidebar && mcpManager.isEnglish"
				}
			],
			"view/title": [
				{
					"command": "antigravity.mcp.openInEditor",
					"when": "view == antigravity.mcpManagerView && !mcpManager.isEnglish",
					"group": "navigation"
				},
				{
					"command": "antigravity.mcp.openInEditor.en",
					"when": "view == antigravity.mcpManagerView && mcpManager.isEnglish",
					"group": "navigation"
				}
			]
		}
	}
}