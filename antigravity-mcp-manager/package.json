{
	"name": "antigravity-mcp-manager",
	"displayName": "MCP 管理儀表板",
	"description": "Antigravity IDE / Cursor / VS Code 相容的 MCP 儀表板：Antigravity 提供左側面板與原生開關；Cursor 與 VS Code 只顯示底部狀態列；目前 IDE 已啟用 Cline 時才並列 Cline MCP 統計（未安裝或已停用則不顯示；Cline 恆為純檢視，本套件不含寫入 API）",
	"version": "1.9.1",
	"publisher": "antigravity-toolkit",
	"engines": {
		"vscode": "^1.80.0"
	},
	"categories": [
		"Other"
	],
	"main": "./extension.js",
	"activationEvents": [
		"onStartupFinished"
	],
	"contributes": {
		"configuration": [
			{
				"title": "Antigravity",
				"properties": {
					"antigravity.locale": {
						"type": "string",
						"default": "zh-TW",
						"enum": [
							"zh-TW",
							"zh-CN",
							"en"
						],
						"enumDescriptions": [
							"繁體中文 (Traditional Chinese)",
							"简体中文 (Simplified Chinese)",
							"English"
						],
						"description": "Antigravity 外掛全域介面語言 (Global Interface Language for Antigravity Plugins)"
					}
				}
			},
			{
				"title": "MCP 管理儀表板",
				"properties": {
					"antigravity.mcp.displayMode": {
						"type": "string",
						"default": "both",
						"enum": [
							"both",
							"antigravity",
							"cline"
						],
						"enumDescriptions": [
							"兩者皆顯示（此 IDE 的 MCP 與 Cline 狀態統計）",
							"僅顯示此 IDE 的 MCP 狀態",
							"僅顯示 Cline MCP 狀態"
						],
						"description": "狀態列上的 MCP 顯示方式（唯一來源，只影響顯示、不影響寫入範圍）。選項值 antigravity 代表目前這個 IDE 自己的 MCP。"
					}
				}
			}
		],
		"viewsContainers": {
			"activitybar": [
				{
					"id": "mcp-manager-container",
					"title": "MCP 伺服器管理",
					"icon": "media/icons/mcp-icon.svg",
					"when": "mcpManager.showSidebar"
				}
			]
		},
		"views": {
			"mcp-manager-container": [
				{
					"type": "webview",
					"id": "antigravity.mcpManagerView",
					"name": "MCP 控制台",
					"icon": "media/icons/mcp-icon.svg",
					"when": "mcpManager.showSidebar"
				}
			]
		},
		"commands": [
			{
				"command": "antigravity.mcp.openQuickMenu",
				"title": "開啟 MCP 快捷選單",
				"category": "MCP",
				"icon": "$(menu)"
			},
			{
				"command": "antigravity.mcp.toggleDisplayMode",
				"title": "切換狀態列顯示方式",
				"category": "MCP",
				"icon": "$(symbol-enum)"
			},
			{
				"command": "antigravity.mcp.viewClineMcp",
				"title": "檢視 Cline MCP 狀態",
				"category": "MCP",
				"icon": "$(eye)"
			},
			{
				"command": "antigravity.mcp.openInEditor",
				"title": "在編輯器分頁開啟",
				"category": "MCP",
				"icon": "$(split-horizontal)"
			},
			{
				"command": "antigravity.mcp.refresh",
				"title": "重新載入 MCP 設定",
				"category": "MCP",
				"icon": "$(refresh)"
			},
			{
				"command": "antigravity.mcp.focusView",
				"title": "聚焦 MCP 側邊欄面板",
				"category": "MCP"
			},
			{
				"command": "antigravity.mcp.openInEditor.en",
				"title": "Open in Editor Tab",
				"category": "MCP",
				"icon": "$(split-horizontal)"
			}
		],
		"menus": {
			"commandPalette": [
				{
					"command": "antigravity.mcp.focusView",
					"when": "mcpManager.showSidebar"
				},
				{
					"command": "antigravity.mcp.openInEditor",
					"when": "mcpManager.showSidebar && !mcpManager.isEnglish"
				},
				{
					"command": "antigravity.mcp.openInEditor.en",
					"when": "mcpManager.showSidebar && mcpManager.isEnglish"
				}
			],
			"view/title": [
				{
					"command": "antigravity.mcp.openInEditor",
					"when": "view == antigravity.mcpManagerView && !mcpManager.isEnglish",
					"group": "navigation"
				},
				{
					"command": "antigravity.mcp.openInEditor.en",
					"when": "view == antigravity.mcpManagerView && mcpManager.isEnglish",
					"group": "navigation"
				}
			]
		}
	}
}