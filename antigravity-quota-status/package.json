{
  "name": "ai-quota-status",
  "displayName": "AI 模型額度狀態監控",
  "description": "於 IDE 狀態列常駐呈現 AI 額度：Antigravity 為 Gemini/Claude 雙層配額，Cursor 為 Auto/API 月結用量",
  "version": "1.1.0",
  "publisher": "antigravity-toolkit",
  "engines": {
    "vscode": "^1.68.0"
  },
  "main": "./extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "commands": [
      {
        "command": "aiQuota.refresh",
        "title": "重新整理 AI 模型額度"
      },
      {
        "command": "aiQuota.showMenu",
        "title": "開啟 AI 模型額度選單"
      },
      {
        "command": "aiQuota.switchAccount",
        "title": "切換監控帳號 / 伺服器"
      },
      {
        "command": "aiQuota.openDashboard",
        "title": "開啟 Cursor Spending 儀表板"
      },
      {
        "command": "aiQuota.toggleDisplayMode",
        "title": "切換狀態列顯示模式"
      },
      {
        "command": "aiQuota.setBackgroundColor",
        "title": "設定狀態列背景顏色"
      },
      {
        "command": "aiQuota.setRefreshInterval",
        "title": "設定背景檢查間隔"
      }
    ],
    "configuration": {
      "title": "AI 額度狀態監控設定",
      "properties": {
        "aiQuota.backend": {
          "type": "string",
          "default": "auto",
          "enum": [
            "auto",
            "antigravity",
            "cursor"
          ],
          "enumDescriptions": [
            "依目前 IDE 自動選擇（Antigravity 用本機 LS，Cursor 用雲端 usage API）",
            "強制使用 Antigravity Language Server",
            "強制使用 Cursor 雲端 usage API"
          ],
          "description": "額度資料來源"
        },
        "aiQuota.locale": {
          "type": "string",
          "default": "auto",
          "enum": [
            "auto",
            "zh-TW",
            "en"
          ],
          "enumDescriptions": [
            "跟隨 Antigravity 語言或 IDE 介面語言",
            "繁體中文",
            "English"
          ],
          "description": "狀態列與 Tooltip 語言"
        },
        "aiQuota.backgroundColor": {
          "type": "string",
          "default": "default",
          "enum": [
            "default",
            "warning",
            "error"
          ],
          "enumDescriptions": [
            "預設無底色 (與狀態列融為一體)",
            "警告色 (黃/橘色背景)",
            "錯誤/危險色 (紅色背景)"
          ],
          "description": "狀態列項目的背景顏色樣式"
        },
        "aiQuota.displayMode": {
          "type": "string",
          "default": "compact",
          "enum": [
            "compact",
            "standard"
          ],
          "enumDescriptions": [
            "極簡雙欄（Antigravity: 59%, 53% | 7%, 100%；Cursor: 45% | 0%）",
            "標準模式（Antigravity: Gemini / Claude；Cursor: Auto / API）"
          ],
          "description": "狀態列上的文字顯示格式"
        },
        "aiQuota.refreshIntervalMinutes": {
          "type": "number",
          "default": 5,
          "description": "背景自動檢查與刷新額度的間隔分鐘數 (設為 0 則關閉自動刷新)"
        },
        "aiQuota.alignment": {
          "type": "string",
          "default": "right",
          "enum": [
            "left",
            "right"
          ],
          "description": "狀態列項目對齊方向 (左側或右側)"
        },
        "aiQuota.priority": {
          "type": "number",
          "default": 30,
          "description": "狀態列項目的優先順序權重"
        }
      }
    }
  }
}
