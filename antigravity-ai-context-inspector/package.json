{
	"name": "antigravity-ai-context-inspector",
	"displayName": "AI 上下文檢視器 (AI Context Inspector)",
	"description": "Google Antigravity IDE、Cursor 與 VS Code 相容側邊欄擴充套件：即時檢視 Rules、Skills、MCP；Cursor 另支援 ~/.cursor/mcp.json 與 agent-transcripts 對話足跡還原；VS Code 讀取 %APPDATA%/Code/User/mcp.json",
	"version": "1.2.0",
	"publisher": "antigravity-toolkit",
	"engines": {
		"vscode": "^1.80.0"
	},
	"categories": [
		"Other"
	],
	"main": "./extension.js",
	"activationEvents": [],
	"contributes": {
		"configuration": {
			"title": "Antigravity",
			"properties": {
				"antigravity.locale": {
					"type": "string",
					"default": "zh-TW",
					"enum": [
						"zh-TW",
						"en"
					],
					"enumDescriptions": [
						"繁體中文 (Traditional Chinese)",
						"English"
					],
					"description": "Antigravity 外掛全域介面語言 (Global Interface Language for Antigravity Plugins)"
				}
			}
		},
		"viewsContainers": {
			"activitybar": [
				{
					"id": "antigravity-ai-context-container",
					"title": "AI 上下文檢視器",
					"icon": "media/icons/inspector-icon.svg"
				}
			]
		},
		"views": {
			"antigravity-ai-context-container": [
				{
					"type": "webview",
					"id": "antigravity.aiContextView",
					"name": "AI Context",
					"icon": "media/icons/inspector-icon.svg"
				}
			]
		},
		"commands": [
			{
				"command": "antigravity.aiContext.openInEditor",
				"title": "在編輯器分頁開啟",
				"category": "Antigravity",
				"icon": "$(split-horizontal)"
			},
			{
				"command": "antigravity.aiContext.refresh",
				"title": "重新整理 AI 上下文",
				"category": "Antigravity",
				"icon": "$(refresh)"
			},
			{
				"command": "antigravity.aiContext.focusView",
				"title": "聚焦 AI 上下文檢視器",
				"category": "Antigravity"
			},
			{
				"command": "antigravity.aiContext.openInEditor.en",
				"title": "Open in Editor Tab",
				"category": "Antigravity",
				"icon": "$(split-horizontal)"
			}
		],
		"menus": {
			"view/title": [
				{
					"command": "antigravity.aiContext.openInEditor",
					"when": "view == antigravity.aiContextView && config.antigravity.locale != 'en'",
					"group": "navigation"
				},
				{
					"command": "antigravity.aiContext.openInEditor.en",
					"when": "view == antigravity.aiContextView && config.antigravity.locale == 'en'",
					"group": "navigation"
				}
			]
		}
	}
}
