{
	"name": "antigravity-quick-access",
	"displayName": "Antigravity 常用捷徑與暫存清單 (Quick Access)",
	"description": "Google Antigravity IDE 檔案總管專屬快速存取與暫存視窗：支援滑鼠拖曳引用至 Chat 對話框與編輯器、檔案與資料夾樹狀展開、雙擊開啟、右鍵一鍵加入、工作區隱藏連動過濾與持久化儲存",
	"version": "1.2.5",
	"publisher": "antigravity-toolkit",
	"engines": {
		"vscode": "^1.80.0"
	},
	"categories": [
		"Other"
	],
	"main": "./extension.js",
	"contributes": {
		"views": {
			"explorer": [
				{
					"id": "antigravity.quickAccessView",
					"name": "常用捷徑與暫存清單",
					"type": "tree",
					"icon": "media/icons/quick-access-icon.svg",
					"order": 1
				}
			]
		},
		"viewsWelcome": [
			{
				"view": "antigravity.quickAccessView",
				"contents": "目前尚未加入任何暫存項目。可於檔案總管對任意檔案或資料夾按右鍵加入暫存清單。"
			}
		],
		"commands": [
			{
				"command": "antigravity.quickAccess.add",
				"title": "加入暫存清單 (Scratchpad)",
				"category": "Quick Access",
				"icon": "$(bookmark)"
			},
			{
				"command": "antigravity.quickAccess.addPinned",
				"title": "加入常規釘選 (Pinned)",
				"category": "Quick Access",
				"icon": "$(pinned)"
			},
			{
				"command": "antigravity.quickAccess.addActive",
				"title": "加入目前開啟的檔案",
				"category": "Quick Access",
				"icon": "$(add)"
			},
			{
				"command": "antigravity.quickAccess.remove",
				"title": "從清單移除",
				"category": "Quick Access",
				"icon": "$(close)"
			},
			{
				"command": "antigravity.quickAccess.togglePin",
				"title": "切換 釘選 / 臨時",
				"category": "Quick Access",
				"icon": "$(pin)"
			},
			{
				"command": "antigravity.quickAccess.clearScratchpad",
				"title": "清空臨時暫存清單",
				"category": "Quick Access",
				"icon": "$(clear-all)"
			},
			{
				"command": "antigravity.quickAccess.refresh",
				"title": "重新整理",
				"category": "Quick Access",
				"icon": "$(refresh)"
			},
			{
				"command": "antigravity.quickAccess.revealInExplorer",
				"title": "在檔案總管中標示",
				"category": "Quick Access",
				"icon": "$(list-tree)"
			},
			{
				"command": "antigravity.quickAccess.revealInOS",
				"title": "在系統檔案總管開啟",
				"category": "Quick Access",
				"icon": "$(folder-opened)"
			},
			{
				"command": "antigravity.quickAccess.addScriptToRunner",
				"title": "加入至專案腳本執行器",
				"category": "Quick Access",
				"icon": "$(symbol-property)"
			},
			{
				"command": "antigravity.quickAccess.viewImages",
				"title": "檢視圖片",
				"category": "Quick Access",
				"icon": "$(file-media)"
			},
			{
				"command": "antigravity.quickAccess.viewAudios",
				"title": "檢視聲音",
				"category": "Quick Access",
				"icon": "$(unmute)"
			},
			{
				"command": "antigravity.quickAccess.viewVideos",
				"title": "檢視影片",
				"category": "Quick Access",
				"icon": "$(device-camera-video)"
			},
			{
				"command": "antigravity.quickAccess.deleteFile",
				"title": "刪除檔案",
				"category": "Quick Access",
				"icon": "$(trash)"
			},
			{
				"command": "antigravity.quickAccess.runBat",
				"title": "執行批次檔",
				"category": "Quick Access",
				"icon": "$(play)"
			},
			{
				"command": "antigravity.quickAccess.runBatAdmin",
				"title": "執行批次檔 (系統管理員)",
				"category": "Quick Access",
				"icon": "$(shield)"
			},
			{
				"command": "antigravity.quickAccess.runPs1",
				"title": "執行 PowerShell 腳本",
				"category": "Quick Access",
				"icon": "$(play)"
			},
			{
				"command": "antigravity.quickAccess.runPs1Admin",
				"title": "執行 PowerShell 腳本 (系統管理員)",
				"category": "Quick Access",
				"icon": "$(shield)"
			},
			{
				"command": "antigravity.quickAccess.runPy",
				"title": "執行 Python 腳本",
				"category": "Quick Access",
				"icon": "$(play)"
			},
			{
				"command": "antigravity.quickAccess.add.en",
				"title": "Add to Scratchpad",
				"category": "Quick Access",
				"icon": "$(bookmark)"
			},
			{
				"command": "antigravity.quickAccess.addPinned.en",
				"title": "Add to Pinned",
				"category": "Quick Access",
				"icon": "$(pinned)"
			},
			{
				"command": "antigravity.quickAccess.addActive.en",
				"title": "Add Active File",
				"category": "Quick Access",
				"icon": "$(add)"
			},
			{
				"command": "antigravity.quickAccess.remove.en",
				"title": "Remove from List",
				"category": "Quick Access",
				"icon": "$(close)"
			},
			{
				"command": "antigravity.quickAccess.togglePin.en",
				"title": "Toggle Pinned / Scratchpad",
				"category": "Quick Access",
				"icon": "$(pin)"
			},
			{
				"command": "antigravity.quickAccess.clearScratchpad.en",
				"title": "Clear Scratchpad",
				"category": "Quick Access",
				"icon": "$(clear-all)"
			},
			{
				"command": "antigravity.quickAccess.refresh.en",
				"title": "Refresh",
				"category": "Quick Access",
				"icon": "$(refresh)"
			},
			{
				"command": "antigravity.quickAccess.revealInExplorer.en",
				"title": "Reveal in Explorer",
				"category": "Quick Access",
				"icon": "$(list-tree)"
			},
			{
				"command": "antigravity.quickAccess.revealInOS.en",
				"title": "Reveal in File Explorer",
				"category": "Quick Access",
				"icon": "$(folder-opened)"
			},
			{
				"command": "antigravity.quickAccess.addScriptToRunner.en",
				"title": "Add to Project Script Runner",
				"category": "Quick Access",
				"icon": "$(symbol-property)"
			},
			{
				"command": "antigravity.quickAccess.viewImages.en",
				"title": "View Images",
				"category": "Quick Access",
				"icon": "$(file-media)"
			},
			{
				"command": "antigravity.quickAccess.viewAudios.en",
				"title": "View Audio",
				"category": "Quick Access",
				"icon": "$(unmute)"
			},
			{
				"command": "antigravity.quickAccess.viewVideos.en",
				"title": "View Videos",
				"category": "Quick Access",
				"icon": "$(device-camera-video)"
			},
			{
				"command": "antigravity.quickAccess.deleteFile.en",
				"title": "Delete File",
				"category": "Quick Access",
				"icon": "$(trash)"
			},
			{
				"command": "antigravity.quickAccess.runBat.en",
				"title": "Run Batch File",
				"category": "Quick Access",
				"icon": "$(play)"
			},
			{
				"command": "antigravity.quickAccess.runBatAdmin.en",
				"title": "Run Batch File (Admin)",
				"category": "Quick Access",
				"icon": "$(shield)"
			},
			{
				"command": "antigravity.quickAccess.runPs1.en",
				"title": "Run PowerShell Script",
				"category": "Quick Access",
				"icon": "$(play)"
			},
			{
				"command": "antigravity.quickAccess.runPs1Admin.en",
				"title": "Run PowerShell Script (Admin)",
				"category": "Quick Access",
				"icon": "$(shield)"
			},
			{
				"command": "antigravity.quickAccess.runPy.en",
				"title": "Run Python Script",
				"category": "Quick Access",
				"icon": "$(play)"
			}
		],
		"keybindings": [
			{
				"command": "antigravity.quickAccess.deleteFile",
				"key": "delete",
				"mac": "cmd+backspace",
				"when": "focusedView == 'antigravity.quickAccessView' && !inputFocus"
			},
			{
				"command": "antigravity.quickAccess.deleteFile",
				"key": "shift+delete",
				"mac": "cmd+backspace",
				"when": "focusedView == 'antigravity.quickAccessView' && !inputFocus"
			}
		],
		"menus": {
			"view/title": [
				{
					"command": "antigravity.quickAccess.addActive",
					"when": "view == antigravity.quickAccessView && config.antigravity.locale != 'en'",
					"group": "navigation@1"
				},
				{
					"command": "antigravity.quickAccess.addActive.en",
					"when": "view == antigravity.quickAccessView && config.antigravity.locale == 'en'",
					"group": "navigation@1"
				},
				{
					"command": "antigravity.quickAccess.clearScratchpad",
					"when": "view == antigravity.quickAccessView && config.antigravity.locale != 'en'",
					"group": "navigation@2"
				},
				{
					"command": "antigravity.quickAccess.clearScratchpad.en",
